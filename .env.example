# ===========================================
# AI Content Automation Studio - Environment
# ===========================================

# App
APP_NAME=ai-content-studio
APP_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=true

# Database
# Supabase option (recommended for hosted DB):
# - Set DATABASE_URL from Supabase Transaction pooler (port 6543)
# - Keep POSTGRES_* as fallback for local/docker
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=content_studio
POSTGRES_USER=studio_user
POSTGRES_PASSWORD=change-this-password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=

# YouTube OAuth 2.0
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/youtube/callback

# Storage (S3-compatible)
STORAGE_TYPE=local
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=content-studio-assets
S3_REGION=auto

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
