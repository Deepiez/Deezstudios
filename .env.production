# ===========================================
# AI Content Automation Studio - PRODUCTION
# ===========================================
# Copy this to .env and fill in real values

# App
APP_NAME=ai-content-studio
APP_ENV=production
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_64_CHARS
DEBUG=false

# Database
# Supabase option (recommended):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=content_studio
POSTGRES_USER=studio_user
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_DB_PASSWORD

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# AI Providers (add your keys)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_GEMINI_API_KEY=AI...

# YouTube OAuth 2.0
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret
YOUTUBE_REDIRECT_URI=https://your-domain.com/api/v1/integrations/youtube/callback

# Storage (MinIO in Docker)
STORAGE_TYPE=s3
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=CHANGE_THIS_MINIO_ACCESS_KEY
S3_SECRET_KEY=CHANGE_THIS_MINIO_SECRET_KEY
S3_BUCKET=content-studio-assets
S3_REGION=auto

# Frontend
NEXT_PUBLIC_API_URL=/api/v1

# Celery
CELERY_BROKER_URL=redis://:CHANGE_THIS_REDIS_PASSWORD@redis:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_THIS_REDIS_PASSWORD@redis:6379/1

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=1440
